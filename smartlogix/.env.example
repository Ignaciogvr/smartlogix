# =========================================
# SmartLogix - Variables de Entorno
# =========================================
#
# INSTRUCCIONES:
# 1. Copia este archivo como .env
# 2. Reemplaza los valores con tus credenciales reales
# 3. NUNCA commitees el archivo .env al repositorio
#
# =========================================

# ================= AUTH0 =================
# Obtener de: https://manage.auth0.com/dashboard
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier

# M2M Application (para comunicación entre microservicios)
AUTH0_M2M_CLIENT_ID=your_m2m_client_id
AUTH0_M2M_CLIENT_SECRET=your_m2m_client_secret

# SPA Application (para el frontend Angular)
AUTH0_SPA_CLIENT_ID=your_spa_client_id

# ================= DATABASE =================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_DB=postgres

# ================= KAFKA =================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ================= SERVICIOS =================
# URLs internas (Docker network)
INVENTORY_SERVICE_URL=http://inventory-service:8081
PEDIDOS_SERVICE_URL=http://pedidos-service:8082
USUARIOS_SERVICE_URL=http://usuarios-service:8083
ENVIO_SERVICE_URL=http://envio-service:8084
